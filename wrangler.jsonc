{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mygymteq-web",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gym-d1-prod",
      "database_id": "46bf7b9d-0284-4f4d-b91e-2caafe5289cf",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "JWT_SECRET": "gym-saas-jwt-super-secret-production-key-2026",
    "APP_ENV": "production"
  }
}
