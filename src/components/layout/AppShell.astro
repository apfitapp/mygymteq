---
import '@/styles/tokens.css';

interface Props {
  title: string;
  activeNav?: 'dashboard' | 'members' | 'payments' | 'attendance' | 'plans' | 'settings';
}

const { title, activeNav = 'dashboard' } = Astro.props;
const user = Astro.locals.user;
const gym = Astro.locals.gym;
const license = Astro.locals.license;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {gym?.name || 'Gym SaaS'}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="app-layout">
      <!-- Sidebar Navigation -->
      <aside class="sidebar">
        <div class="sidebar-header">
          <div class="brand-badge">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6.5 6.5 11 11"/>
              <path d="m21 21-1-1"/>
              <path d="m3 3 1 1"/>
              <path d="m18 22 4-4"/>
              <path d="m2 6 4-4"/>
              <path d="m3 10 7-7"/>
              <path d="m14 21 7-7"/>
            </svg>
          </div>
          <div class="brand-text">
            <span class="gym-name">{gym?.name || 'My Gym'}</span>
            <span class="plan-pill">{license?.status === 'ACTIVE' ? 'License Active' : license?.status}</span>
          </div>
        </div>

        <nav class="nav-links">
          <a href="/dashboard" class:list={['nav-item', { active: activeNav === 'dashboard' }]}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            <span>Dashboard</span>
          </a>

          <a href="/members" class:list={['nav-item', { active: activeNav === 'members' }]}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Members</span>
          </a>

          <a href="/payments" class:list={['nav-item', { active: activeNav === 'payments' }]}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            <span>Payments & Dues</span>
          </a>

          <a href="/attendance" class:list={['nav-item', { active: activeNav === 'attendance' }]}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
            <span>Attendance</span>
          </a>

          <a href="/plans" class:list={['nav-item', { active: activeNav === 'plans' }]}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span>Membership Plans</span>
          </a>
        </nav>

        <div class="sidebar-footer">
          <div class="user-pill">
            <div class="avatar">{user?.name?.slice(0, 2).toUpperCase() || 'U'}</div>
            <div class="user-info">
              <span class="user-name">{user?.name}</span>
              <span class="user-role">{user?.role}</span>
            </div>
          </div>
          <form method="POST" action="/logout" class="logout-form">
            <button type="submit" class="logout-btn" title="Sign out">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
            </button>
          </form>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="main-wrapper">
        <header class="topbar">
          <div class="topbar-title">
            <h1>{title}</h1>
          </div>
          <div class="topbar-actions">
            <a href="/attendance" class="quick-checkin-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
              <span>Quick Check-In</span>
            </a>
            <button class="theme-toggle" id="theme-btn" type="button" aria-label="Toggle theme">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            </button>
          </div>
        </header>

        <main class="page-content">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      const btn = document.getElementById('theme-btn');
      if (btn) {
        btn.addEventListener('click', () => {
          document.body.classList.toggle('dark-theme');
          const isDark = document.body.classList.contains('dark-theme');
          localStorage.setItem('gym_theme', isDark ? 'dark' : 'light');
        });
        if (localStorage.getItem('gym_theme') === 'dark') {
          document.body.classList.add('dark-theme');
        }
      }
    </script>
  </body>
</html>

<style>
  .app-layout {
    display: flex;
    min-height: 100vh;
  }

  .sidebar {
    width: 260px;
    background-color: var(--surface);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
    padding: var(--space-md);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-md);
  }

  .brand-badge {
    width: 40px;
    height: 40px;
    background-color: var(--accent);
    color: var(--accent-on);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .gym-name {
    font-weight: 700;
    font-size: 14px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 160px;
  }

  .plan-pill {
    font-size: 11px;
    font-weight: 600;
    color: var(--ok);
    background: var(--ok-soft);
    padding: 1px 6px;
    border-radius: 99px;
    width: fit-content;
    margin-top: 2px;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-weight: 500;
    font-size: 14px;
    transition: all var(--dur) var(--ease);
  }

  .nav-item:hover {
    background-color: var(--surface-2);
    color: var(--ink);
  }

  .nav-item.active {
    background-color: var(--accent-soft);
    color: var(--accent-strong);
    font-weight: 600;
  }

  .sidebar-footer {
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .user-pill {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--surface-2);
    color: var(--ink);
    font-weight: 700;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
  }

  .user-info {
    display: flex;
    flex-direction: column;
  }

  .user-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }

  .user-role {
    font-size: 11px;
    color: var(--muted);
    text-transform: capitalize;
  }

  .logout-btn {
    background: transparent;
    border: 1px solid var(--line);
    padding: 6px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logout-btn:hover {
    color: var(--err);
    background-color: var(--err-soft);
    border-color: var(--err);
  }

  .main-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .topbar {
    height: var(--header-h);
    background-color: var(--surface);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-xl);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .topbar-title h1 {
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .quick-checkin-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--accent);
    color: var(--accent-on);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    transition: background-color var(--dur) var(--ease);
  }

  .quick-checkin-btn:hover {
    background-color: var(--accent-strong);
  }

  .theme-toggle {
    background: var(--surface-2);
    border: 1px solid var(--line);
    padding: 8px;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .page-content {
    padding: var(--space-xl);
    flex: 1;
    max-width: var(--maxw);
    width: 100%;
    margin: 0 auto;
  }
</style>
