---
import AdminShell from '@/components/layout/AdminShell.astro';
import Badge from '@/components/ui/Badge.astro';
import { AdminService } from '@/server/services/admin.service';
import { actions } from 'astro:actions';

const db = Astro.locals.runtime?.env?.DB;
const user = Astro.locals.user;

if (!db || !user || user.role !== 'SUPER_ADMIN') {
  return Astro.redirect('/login');
}

const adminService = new AdminService(db);
const [gyms, plans] = await Promise.all([
  adminService.listGyms(),
  adminService.listPlans(),
]);

const result = Astro.getActionResult(actions.admin.createGym);
const errorMessage = result?.error ? result.error.message : null;
const successData = result && !result.error ? result.data : null;
---

<AdminShell title="Platform Management — Gyms & Tenants" activeNav="gyms">
  <div class="admin-grid">
    <!-- Left Column: Gym Directory -->
    <div class="gyms-section">
      <div class="section-header">
        <div>
          <h2>Subscribed Gyms</h2>
          <p class="subtitle">All tenant gyms running on the platform</p>
        </div>
        <span class="count-pill">{gyms.length} Gyms</span>
      </div>

      <div class="table-card">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Gym Name & City</th>
              <th>Commercial Plan</th>
              <th>Members</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {gyms.map((g) => (
              <tr>
                <td>
                  <div class="gym-info">
                    <strong class="name">{g.name}</strong>
                    <span class="meta font-mono">{g.city || 'India'} • {g.phone}</span>
                  </div>
                </td>
                <td>
                  <span class="plan-tag font-mono">{g.plan_name || 'Pro'}</span>
                </td>
                <td>
                  <span class="font-mono">{g.member_count || 0} / {g.max_members === -1 ? '∞' : g.max_members}</span>
                </td>
                <td>
                  <Badge variant={g.status === 'ACTIVE' ? 'ok' : 'err'} size="sm">
                    {g.status}
                  </Badge>
                </td>
                <td>
                  <form method="POST" action={actions.admin.toggleStatus}>
                    <input type="hidden" name="gymId" value={g.id} />
                    <input type="hidden" name="status" value={g.status === 'ACTIVE' ? 'SUSPENDED' : 'ACTIVE'} />
                    <button type="submit" class:list={['toggle-btn', { suspend: g.status === 'ACTIVE' }]}>
                      {g.status === 'ACTIVE' ? 'Suspend' : 'Reactivate'}
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Right Column: Provision New Gym & Owner Form -->
    <div class="provision-section">
      <div class="provision-card">
        <h3>Onboard New Gym</h3>
        <p class="subtitle">Create gym account and assign primary owner</p>

        {errorMessage && (
          <div class="error-banner">
            <span>{errorMessage}</span>
          </div>
        )}

        {successData && (
          <div class="success-banner">
            <span>Gym onboarded and owner account activated!</span>
          </div>
        )}

        <form method="POST" action={actions.admin.createGym} class="admin-form">
          <div class="field">
            <label for="gymName">Gym Name *</label>
            <input type="text" id="gymName" name="gymName" required placeholder="e.g. Gold Coast Fitness" />
          </div>

          <div class="grid-2">
            <div class="field">
              <label for="slug">Slug *</label>
              <input type="text" id="slug" name="slug" required placeholder="e.g. gold-coast" />
            </div>
            <div class="field">
              <label for="city">City</label>
              <input type="text" id="city" name="city" placeholder="e.g. Bangalore" />
            </div>
          </div>

          <div class="field">
            <label for="gymPhone">Gym Phone (10 Digits) *</label>
            <input type="tel" id="gymPhone" name="gymPhone" required placeholder="9876543210" />
          </div>

          <div class="field">
            <label for="planId">Commercial SaaS Plan *</label>
            <select id="planId" name="planId" required>
              {plans.map((p) => (
                <option value={p.id}>
                  {p.name} (₹{p.price_monthly / 100}/mo)
                </option>
              ))}
            </select>
          </div>

          <hr class="divider" />

          <h4>Owner Account Setup</h4>

          <div class="field">
            <label for="ownerName">Owner Name *</label>
            <input type="text" id="ownerName" name="ownerName" required placeholder="e.g. Rajesh Kumar" />
          </div>

          <div class="grid-2">
            <div class="field">
              <label for="ownerEmail">Owner Email *</label>
              <input type="email" id="ownerEmail" name="ownerEmail" required placeholder="owner@gym.com" />
            </div>
            <div class="field">
              <label for="ownerPhone">Owner Phone *</label>
              <input type="tel" id="ownerPhone" name="ownerPhone" required placeholder="9876543210" />
            </div>
          </div>

          <div class="field">
            <label for="ownerPassword">Initial Password *</label>
            <input type="password" id="ownerPassword" name="ownerPassword" required minlength="6" value="admin123" />
          </div>

          <button type="submit" class="submit-btn">Provision Gym & Owner</button>
        </form>
      </div>
    </div>
  </div>
</AdminShell>

<style>
  .admin-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-xl);
  }

  @media (max-width: 900px) {
    .admin-grid {
      grid-template-columns: 1fr;
    }
  }

  .gyms-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .section-header h2 {
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
  }

  .subtitle {
    font-size: 12px;
    color: var(--muted);
  }

  .count-pill {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    background: var(--surface-2);
    padding: 2px 8px;
    border-radius: 99px;
  }

  .table-card {
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .admin-table th {
    text-align: left;
    padding: 10px 12px;
    background-color: var(--surface-2);
    color: var(--muted);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line);
  }

  .admin-table td {
    padding: 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  .gym-info {
    display: flex;
    flex-direction: column;
  }

  .gym-info .name {
    color: var(--ink);
  }

  .gym-info .meta {
    font-size: 11px;
    color: var(--muted);
  }

  .plan-tag {
    font-size: 11px;
    font-weight: 600;
    background: var(--surface-2);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .toggle-btn {
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    color: var(--ink);
  }

  .toggle-btn.suspend {
    color: var(--err);
  }

  .toggle-btn.suspend:hover {
    background: var(--err-soft);
    border-color: var(--err);
  }

  .provision-card {
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
  }

  .provision-card h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
  }

  .provision-card h4 {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    margin-top: var(--space-xs);
  }

  .divider {
    border: none;
    border-top: 1px solid var(--line);
    margin: var(--space-sm) 0;
  }

  .admin-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .field label {
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-2);
  }

  .field input, .field select {
    padding: 8px 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background-color: var(--surface-2);
    color: var(--ink);
    font-size: 13px;
  }

  .field input:focus, .field select:focus {
    outline: none;
    border-color: var(--accent-strong);
    background-color: var(--surface);
  }

  .submit-btn {
    background-color: var(--ink);
    color: var(--bg);
    border: none;
    padding: 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    margin-top: var(--space-xs);
  }

  .submit-btn:hover {
    background-color: #000;
  }

  .error-banner {
    background-color: var(--err-soft);
    border: 1px solid var(--err);
    color: var(--err);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: 12px;
    margin: var(--space-sm) 0;
  }

  .success-banner {
    background-color: var(--ok-soft);
    border: 1px solid var(--ok);
    color: var(--ok);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: 12px;
    margin: var(--space-sm) 0;
  }
</style>
