---
import '@/styles/tokens.css';

const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MyGymTeq — Multi-Tenant Gym & Fitness Management SaaS</title>
    <meta name="description" content="Next-generation multi-tenant Gym Management Platform powered by Cloudflare Workers & D1. Member tracking, automated WhatsApp receipts, and fast check-in." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="landing-container">
      <!-- Top Navigation -->
      <header class="landing-header">
        <div class="header-inner">
          <a href="/" class="brand">
            <div class="logo-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 18h12"></path><path d="M6 6h12"></path><path d="M6 12h12"></path>
              </svg>
            </div>
            <span class="brand-text">MyGym<span>Teq</span></span>
          </a>

          <nav class="nav-links">
            <a href="#features">Features</a>
            <a href="#whatsapp">WhatsApp Automation</a>
            <a href="#pricing">License Plans</a>
          </nav>

          <div class="header-actions">
            <button class="theme-toggle" id="theme-btn" type="button" aria-label="Toggle theme">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
              </svg>
            </button>

            {user ? (
              <a href={user.role === 'SUPER_ADMIN' ? '/admin' : '/dashboard'} class="btn-primary">
                <span>Go to Dashboard</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            ) : (
              <div class="auth-buttons">
                <a href="/login" class="btn-outline">Sign In</a>
                <a href="/login" class="btn-primary">Get Started</a>
              </div>
            )}
          </div>
        </div>
      </header>

      <!-- Hero Section -->
      <section class="hero-section">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>⚡ Built for High-Performance Gyms & Fitness Centers</span>
          </div>

          <h1 class="hero-title">
            Elevate Your Gym Operations to <span class="gradient-text">Peak Performance</span>
          </h1>

          <p class="hero-subtitle">
            The all-in-one software for modern gym owners and trainers. Fast member registrations, 1-tap WhatsApp payment receipts, instant QR/kiosk check-ins, and zero lost revenues.
          </p>

          <div class="hero-cta">
            <a href={user ? '/dashboard' : '/login'} class="btn-hero-primary">
              <span>{user ? 'Enter Gym Portal' : 'Start Free Demo'}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/login" class="btn-hero-secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              <span>Explore Demo Credentials</span>
            </a>
          </div>

          <div class="hero-stats">
            <div class="stat-item">
              <div class="stat-value">Instant</div>
              <div class="stat-label">Fast Member Check-In</div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <div class="stat-value">1-Tap</div>
              <div class="stat-label">WhatsApp Receipts</div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <div class="stat-value">100%</div>
              <div class="stat-label">Data Privacy & Security</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section id="features" class="features-section">
        <div class="section-header">
          <h2 class="section-title">Everything Your Gym Needs to Grow</h2>
          <p class="section-subtitle">Save hours of manual paperwork, eliminate member fee leakage, and deliver a 5-star member experience.</p>
        </div>

        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3>Smart Member Management</h3>
            <p>Track active memberships, pending renewals, contact details, emergency contacts, and personal training packages in clean, searchable member profiles.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
            </div>
            <h3>Lightning Quick Check-In</h3>
            <p>Fast attendance logging via phone number, member ID, or self-service kiosk with immediate visual verification to stop unpaid access at the front desk.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h3>Fee Collection & Due Tracking</h3>
            <p>Record cash, UPI, or card payments with partial due tracking, automated receipt generation, and renewal calculations tailored to your plans.</p>
          </div>

          <div class="feature-card" id="whatsapp">
            <div class="feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </div>
            <h3>1-Tap WhatsApp Receipts</h3>
            <p>Send personalized welcome messages, instant digital fee receipts, and upcoming expiration reminders directly to member WhatsApp chats.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Role-Based Staff Access</h3>
            <p>Control what staff and trainers can see. Grant desk staff check-in and registration access while keeping sensitive financial totals private to owners.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <h3>Zero Lag During Peak Hours</h3>
            <p>Built for morning and evening gym rush hours. Enjoy instantaneous page loads and attendance confirmation with 99.99% uptime.</p>
          </div>
        </div>
      </section>

      <!-- Pricing Plans -->
      <section id="pricing" class="pricing-section">
        <div class="section-header">
          <h2 class="section-title">Transparent Tiered Licenses</h2>
          <p class="section-subtitle">Choose the plan that matches your facility scale. Upgrade anytime as your member count grows.</p>
        </div>

        <div class="pricing-grid">
          <div class="pricing-card">
            <div class="plan-header">
              <span class="plan-name">Starter</span>
              <div class="plan-price">₹1,499<span>/mo</span></div>
              <p class="plan-desc">Perfect for boutique studios and single-owner gyms.</p>
            </div>
            <ul class="plan-features">
              <li>✓ Up to 150 Active Members</li>
              <li>✓ 3 Staff / Trainer Logins</li>
              <li>✓ Full Attendance & Quick Check-In</li>
              <li>✓ WhatsApp Welcome & Payment Alerts</li>
              <li>✓ Standard Analytics Dashboard</li>
            </ul>
            <a href="/login" class="btn-plan">Get Started</a>
          </div>

          <div class="pricing-card featured">
            <div class="popular-badge">Most Popular</div>
            <div class="plan-header">
              <span class="plan-name">Professional</span>
              <div class="plan-price">₹2,999<span>/mo</span></div>
              <p class="plan-desc">For growing fitness centers with high daily footfall.</p>
            </div>
            <ul class="plan-features">
              <li>✓ Up to 500 Active Members</li>
              <li>✓ 10 Staff / Trainer Logins</li>
              <li>✓ Automated Due Reminders</li>
              <li>✓ Advanced Revenue & Trend Analytics</li>
              <li>✓ Priority Edge Sync</li>
              <li>✓ Custom Branding & Receipts</li>
            </ul>
            <a href="/login" class="btn-plan btn-featured">Start Pro Trial</a>
          </div>

          <div class="pricing-card">
            <div class="plan-header">
              <span class="plan-name">Enterprise / Multi-Branch</span>
              <div class="plan-price">₹5,999<span>/mo</span></div>
              <p class="plan-desc">For gym chains requiring custom capacity and multi-branch management.</p>
            </div>
            <ul class="plan-features">
              <li>✓ Unlimited Active Members</li>
              <li>✓ Unlimited Staff Accounts</li>
              <li>✓ Multi-Branch Centralized Admin</li>
              <li>✓ Dedicated Database Provisioning</li>
              <li>✓ 24/7 SLA & Dedicated Support</li>
            </ul>
            <a href="/login" class="btn-plan">Contact Sales</a>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="landing-footer">
        <div class="footer-content">
          <div class="brand">
            <span class="brand-text">MyGym<span>Teq</span></span>
            <p class="footer-tagline">Cloudflare Edge Gym Management Platform &bull; © 2026 MyGymTeq</p>
          </div>
          <div class="footer-links">
            <a href="/login">Gym Portal Sign In</a>
            <a href="/login">Platform Admin</a>
          </div>
        </div>
      </footer>
    </div>

    <script is:inline>
      // Theme Toggle Logic
      const themeBtn = document.getElementById('theme-btn');
      const savedTheme = localStorage.getItem('theme') || 'dark';
      
      if (savedTheme === 'dark') {
        document.body.classList.add('dark-theme');
      }

      themeBtn?.addEventListener('click', () => {
        document.body.classList.toggle('dark-theme');
        const isDark = document.body.classList.contains('dark-theme');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>

<style>
  .landing-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--bg);
  }

  /* Header */
  .landing-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(16px);
    background-color: rgba(250, 249, 246, 0.85);
    border-bottom: 1px solid var(--line);
  }

  :global(.dark-theme) .landing-header {
    background-color: rgba(20, 19, 17, 0.85);
  }

  .header-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 700;
  }

  .logo-box {
    width: 36px;
    height: 36px;
    background: var(--accent);
    color: var(--accent-on);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px var(--accent-soft);
  }

  .brand-text {
    font-size: 1.25rem;
    font-family: var(--font-display);
    color: var(--ink);
  }

  .brand-text span {
    color: var(--accent-strong);
  }

  .nav-links {
    display: none;
    gap: 2rem;
    font-weight: 500;
    color: var(--ink-2);
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-links a:hover {
    color: var(--accent-strong);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .auth-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theme-toggle {
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--ink);
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--dur) var(--ease);
  }

  .theme-toggle:hover {
    background: var(--line);
  }

  .btn-outline {
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.875rem;
    transition: all var(--dur) var(--ease);
  }

  .btn-outline:hover {
    border-color: var(--ink);
    background: var(--surface-2);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.125rem;
    background: var(--accent);
    color: var(--accent-on);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.875rem;
    transition: all var(--dur) var(--ease);
  }

  .btn-primary:hover {
    filter: brightness(1.08);
    box-shadow: 0 4px 14px var(--accent-soft);
  }

  /* Hero Section */
  .hero-section {
    padding: 5rem 1.5rem 4rem;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.875rem;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent);
  }

  .hero-title {
    font-size: 2.75rem;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent-strong) 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 680px;
    margin: 0 auto 2.5rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    background: var(--accent);
    color: var(--accent-on);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 1rem;
    transition: all var(--dur) var(--ease);
  }

  .btn-hero-primary:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--accent-soft);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 1rem;
    transition: all var(--dur) var(--ease);
  }

  .btn-hero-secondary:hover {
    background: var(--surface-2);
    border-color: var(--ink-2);
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent-strong);
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--line);
  }

  /* Features */
  .features-section {
    padding: 5rem 1.5rem;
    max-width: var(--maxw);
    margin: 0 auto;
    width: 100%;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    transition: all var(--dur) var(--ease);
  }

  .feature-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .feature-card p {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* Pricing Section */
  .pricing-section {
    padding: 5rem 1.5rem;
    max-width: var(--maxw);
    margin: 0 auto;
    width: 100%;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pricing-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all var(--dur) var(--ease);
  }

  .pricing-card.featured {
    border-color: var(--accent);
    box-shadow: 0 8px 32px var(--accent-soft);
  }

  .popular-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: var(--accent-on);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .plan-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
  }

  .plan-price {
    font-size: 2.5rem;
    font-weight: 800;
    font-family: var(--font-display);
    color: var(--ink);
    margin: 0.75rem 0 0.5rem;
  }

  .plan-price span {
    font-size: 1rem;
    font-weight: 500;
    color: var(--muted);
    font-family: var(--font-body);
  }

  .plan-desc {
    color: var(--muted);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .plan-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-grow: 1;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .btn-plan {
    display: block;
    text-align: center;
    padding: 0.75rem 1rem;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    border-radius: var(--radius-md);
    font-weight: 600;
    transition: all var(--dur) var(--ease);
  }

  .btn-plan:hover {
    background: var(--line);
  }

  .btn-featured {
    background: var(--accent);
    color: var(--accent-on);
    border-color: var(--accent);
  }

  .btn-featured:hover {
    filter: brightness(1.08);
  }

  /* Footer */
  .landing-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    padding: 2.5rem 1.5rem;
    background: var(--surface);
  }

  .footer-content {
    max-width: var(--maxw);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 640px) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }

  .footer-links a:hover {
    color: var(--accent-strong);
  }
</style>
