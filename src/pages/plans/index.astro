---
import AppShell from '@/components/layout/AppShell.astro';
import Badge from '@/components/ui/Badge.astro';
import { PlanRepository } from '@/server/repositories/plan.repository';
import { actions } from 'astro:actions';

const db = Astro.locals.runtime?.env?.DB;
const gym = Astro.locals.gym;

if (!db || !gym) {
  return Astro.redirect('/login');
}

const planRepo = new PlanRepository(db, gym.id);
const plans = await planRepo.listAll();

const result = Astro.getActionResult(actions.memberships.createPlan);
const errorMessage = result?.error ? result.error.message : null;
const successData = result && !result.error ? result.data : null;
---

<AppShell title="Membership Plans" activeNav="plans">
  <div class="plans-layout">
    <!-- Left Column: Catalog List -->
    <div class="catalog-section">
      <div class="section-header">
        <div>
          <h2>Gym Plan Offerings</h2>
          <p class="subtitle">Plans available for new and renewing members</p>
        </div>
        <span class="count-pill">{plans.length} Plans</span>
      </div>

      <div class="plans-grid">
        {plans.map((p) => (
          <div class:list={['plan-card', { inactive: p.is_active === 0 }]}>
            <div class="plan-header">
              <h3>{p.name}</h3>
              <Badge variant={p.is_active === 1 ? 'ok' : 'muted'} size="sm">
                {p.is_active === 1 ? 'Active' : 'Archived'}
              </Badge>
            </div>

            <div class="plan-price font-display">
              ₹{(p.price / 100).toLocaleString('en-IN')}
              <span class="duration font-mono">/ {p.duration_months} Month{p.duration_months > 1 ? 's' : ''}</span>
            </div>

            {p.description && <p class="plan-desc">{p.description}</p>}

            <div class="plan-meta">
              <span class="meta-item">
                Admission Fee: <strong>₹{(p.admission_fee / 100).toLocaleString('en-IN')}</strong>
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Column: Add New Plan Form -->
    <div class="create-plan-section">
      <div class="create-card">
        <h3>Create New Plan</h3>
        <p class="subtitle">Add a custom package to your gym catalog</p>

        {errorMessage && (
          <div class="error-banner">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <span>{errorMessage}</span>
          </div>
        )}

        {successData && (
          <div class="success-banner">
            <span>New plan created and active!</span>
          </div>
        )}

        <form method="POST" action={actions.memberships.createPlan} class="plan-form">
          <div class="field">
            <label for="name">Plan Title *</label>
            <input type="text" id="name" name="name" required placeholder="e.g. 6 Months Strength + Cardio" />
          </div>

          <div class="field">
            <label for="durationMonths">Duration (Months) *</label>
            <select id="durationMonths" name="durationMonths" required>
              <option value="1">1 Month</option>
              <option value="3">3 Months (Quarterly)</option>
              <option value="6">6 Months (Half-Yearly)</option>
              <option value="12">12 Months (Annual)</option>
            </select>
          </div>

          <div class="field">
            <label for="price">Plan Fee (₹) *</label>
            <input type="number" id="price" name="price" required min="100" placeholder="e.g. 5000" />
          </div>

          <div class="field">
            <label for="admissionFee">One-Time Admission Fee (₹)</label>
            <input type="number" id="admissionFee" name="admissionFee" min="0" value="0" />
          </div>

          <div class="field">
            <label for="description">Description / Inclusions</label>
            <textarea id="description" name="description" rows="2" placeholder="e.g. Includes locker and diet consultation"></textarea>
          </div>

          <button type="submit" class="submit-btn">Save Plan</button>
        </form>
      </div>
    </div>
  </div>
</AppShell>

<style>
  .plans-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-xl);
  }

  @media (max-width: 900px) {
    .plans-layout {
      grid-template-columns: 1fr;
    }
  }

  .catalog-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--line);
  }

  .section-header h2 {
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
  }

  .subtitle {
    font-size: 12px;
    color: var(--muted);
  }

  .count-pill {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    background: var(--surface-2);
    padding: 2px 8px;
    border-radius: 99px;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-md);
  }

  .plan-card {
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    box-shadow: var(--shadow-sm);
  }

  .plan-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .plan-header h3 {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }

  .plan-price {
    font-size: 24px;
    font-weight: 700;
    color: var(--accent-strong);
    margin: var(--space-2xs) 0;
  }

  .plan-price .duration {
    font-size: 12px;
    color: var(--muted);
    font-weight: 400;
  }

  .plan-desc {
    font-size: 12px;
    color: var(--ink-2);
    line-height: 1.4;
  }

  .plan-meta {
    margin-top: auto;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--line);
    font-size: 11px;
    color: var(--muted);
  }

  .create-card {
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
  }

  .create-card h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
  }

  .error-banner {
    background-color: var(--err-soft);
    border: 1px solid var(--err);
    color: var(--err);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 4px;
    margin: var(--space-sm) 0;
  }

  .success-banner {
    background-color: var(--ok-soft);
    border: 1px solid var(--ok);
    color: var(--ok);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: 12px;
    margin: var(--space-sm) 0;
  }

  .plan-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .field label {
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-2);
  }

  .field input, .field select, .field textarea {
    padding: 8px 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background-color: var(--surface-2);
    color: var(--ink);
    font-size: 13px;
  }

  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none;
    border-color: var(--accent-strong);
    background-color: var(--surface);
  }

  .submit-btn {
    background-color: var(--accent);
    color: var(--accent-on);
    border: none;
    padding: 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    margin-top: var(--space-xs);
  }

  .submit-btn:hover {
    background-color: var(--accent-strong);
  }
</style>
