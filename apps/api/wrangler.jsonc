{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mygymteq-api",
  "account_id": "254f1f1eb75c7989e323f5b139142ca9",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gym-d1-prod",
      "database_id": "46bf7b9d-0284-4f4d-b91e-2caafe5289cf",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "vars": {
    "JWT_SECRET": "gym-saas-dev-secret-super-secure-key-2026",
    "ENVIRONMENT": "development"
  },
  "triggers": {
    "crons": ["31 18 * * *"] // 18:31 UTC = 00:01 IST
  }
}
